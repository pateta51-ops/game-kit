{
  "name": "game-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage && npm run coverage:table",
    "coverage:table": "node scripts/coverage-table.mjs",
    "components:check": "node scripts/check-components.mjs && node scripts/catalog.mjs --check && node scripts/plan.mjs --check && node scripts/readme-examples.mjs && node tuners/build.mjs --check",
    "check": "npm run lint && npm run typecheck && npm run test && npm run components:check && npm run personal",
    "personal": "node scripts/personal-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright-core": "1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.170.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
