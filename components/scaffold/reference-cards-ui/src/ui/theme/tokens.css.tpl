:root {
  --card-font: sans-serif;
  --card-size: 20px;
  --card-ink: #000;
  --card-paper: #fff;
}
body {
  font-family: var(--card-font);
  font-size: var(--card-size);
  color: var(--card-ink);
  background: var(--card-paper);
}
button, input, select {
  font-family: var(--card-font);
  font-size: inherit;
}
