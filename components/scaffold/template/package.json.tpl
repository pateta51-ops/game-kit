{
  "name": "{{id}}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "phone": "npm run build && vite preview --host 127.0.0.1 --port {{phone}} --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node tests/scaffold.e2e.mjs",
    "browser:install": "playwright-core install chromium",
    "kit:check": "node kit/kit.mjs check",
    "ci:check": "node kit/ci-templates/render.mjs --check",
    "repo-gate": "node kit/repo-gate/repo-gate.ts",
    "size": "node kit/bundle-size/check-bundle-size.ts --dir dist --config size.config.json",
    "check:chain": "npm run test && npm run lint && npm run typecheck && npm run kit:check && npm run ci:check && npm run repo-gate && npm run build && npm run size",
    "check": "node kit/check-runner/check-runner.ts --config scripts/check-runner.config.json"
  },
  "kit": { "e2eRoots": ["src/ui"] },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright-core": "1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
