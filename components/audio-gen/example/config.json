  "yue2": {"type": "yue2", "licence": "CC BY-NC 4.0 (YuE2-3B weights, non-commercial)", "model": "m-a-p/YuE2-3B", "revision": "8f24312f", "version": "0.1.6", "modelDir": "~/audio-gen/models/yue2", "python": "~/audio-gen/venv-yue/bin/python", "demucsPython": "~/audio-gen/venv-demucs/bin/python", "tries": 6}
 }
